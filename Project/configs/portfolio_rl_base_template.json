{
  "tickers": ["AAPL", "MSFT", "TSLA", "DUK", "PGR"],
  "data": {
    "data_dir": "data",
    "train_ratio": 0.8
  },
  "env": {
    "window_size": 50,
    "episode_length": 64,
    "transaction_cost": 0.001,
    "annual_rf_rate": 0.04,
    "turnover_penalty": 0.001
  },
  "eval_env": {
    "window_size": 50,
    "episode_length": null,
    "transaction_cost": 0.001,
    "annual_rf_rate": 0.04,
    "turnover_penalty": 0.001
  },
  "ppo": {
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_eps": 0.2,
    "actor_lr": 0.0003,
    "critic_lr": 0.0003,
    "entropy_coef": 0.001,
    "value_coef": 0.5,
    "max_grad_norm": 1.0
  },
  "train": {
    "total_timesteps": 10000,
    "rollout_steps": 256,
    "update_epochs": 4,
    "batch_size": 64,
    "seed": 42
  },
  "model": {
    "backbone_type": "mlp",
    "hidden_size": 128
  }
}
